# Public configuration. These values are embedded in browser bundles.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Performance tracing only. Use 0.1 in Production and 1 in Preview/Development.
SENTRY_TRACES_SAMPLE_RATE=1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1

# Sentry environment is generated by next.config.ts for all runtimes:
# GitHub Actions -> ci; VERCEL_ENV -> production/preview; otherwise -> local.
# Local `next build && next start` stays local. Rebuild when changing deployment target.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT is generated; do not set it manually.
