# 必填：公开数据库配置，会进入浏览器构建产物。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 本地 Passkey 使用 localhost；生产部署填写正式站点地址。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 可选：覆盖内置的 Sentry DSN（公开标识，可带 NEXT_PUBLIC_ 前缀）。
NEXT_PUBLIC_SENTRY_DSN=

# 可选：性能追踪采样率（0–1），不控制错误事件上报。
SENTRY_TRACES_SAMPLE_RATE=1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1
# 可选：Sentry 源码映射上传令牌，仅限构建和本地运维，禁止 NEXT_PUBLIC_ 前缀。
SENTRY_AUTH_TOKEN=

# 本地 npm run owner:login 需要 OWNER_EMAIL 与 SUPABASE_SECRET_KEY。该脚本不读取 SUPABASE_SERVICE_ROLE_KEY。
OWNER_EMAIL=
SUPABASE_SECRET_KEY=
# 可选：远程浏览器 Agent 的登录口令。只通过 POST /auth/agent-login 的 Authorization: Bearer 提交；留空则该接口返回 404。生产环境不设置。不要写入 URL。
AGENT_LOGIN_TOKEN=

# SUPABASE_SECRET_KEY 未设置时，服务端用它调用 Admin API（设置页生成链接、/auth/agent-login、开发登录）。生产环境使用这个名字。本地管理 E2E 也会读取，禁止把生产密钥用于测试。
SUPABASE_SERVICE_ROLE_KEY=
