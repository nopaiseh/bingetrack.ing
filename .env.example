# 必填：公开数据库配置，会进入浏览器构建产物。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 本地 Passkey 使用 localhost；生产部署填写正式站点地址。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 可选：性能追踪采样率（0–1），不控制错误事件上报。
SENTRY_TRACES_SAMPLE_RATE=1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1
# 可选：Sentry 源码映射上传令牌，仅限构建和本地运维，禁止 NEXT_PUBLIC_ 前缀。
SENTRY_AUTH_TOKEN=

# 可选：仅手动运行 owner:login 时需要，日常网站不使用此运维密钥。
OWNER_EMAIL=
SUPABASE_SECRET_KEY=

# 可选：仅本地 Supabase 管理 E2E 使用，禁止使用生产 service-role 密钥运行测试。
SUPABASE_SERVICE_ROLE_KEY=
