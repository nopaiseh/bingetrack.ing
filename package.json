{
  "name": "nopaiseh",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run env:check",
    "build": "next build",
    "analyze": "next experimental-analyze --output",
    "perf:lighthouse": "node scripts/run-lighthouse.mjs",
    "start": "next start",
    "lint": "eslint",
    "env:check": "node --env-file-if-exists=.env.local scripts/check-env.mjs",
    "smoke": "node scripts/smoke-deployment.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "owner:login": "node --env-file=.env.local scripts/prepare-owner-login.mjs",
    "postinstall": "node scripts/patch-unocss.mjs && node scripts/patch-next-code-frame.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "10.74.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.3.5",
    "postcss": "8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "^1.2.92",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@unocss/postcss": "^66.10.2",
    "@unocss/preset-icons": "^66.10.2",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "typescript": "^5",
    "unocss": "^66.10.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
